# Example .env for SAP ABAP ADT MCP server

# ABAP system URL and client
SAP_URL=https://your-abap-system.com
SAP_CLIENT=100

# Optional: language (default is 'en' if not set)
SAP_LANGUAGE=en

# TLS: set to 0 to allow self-signed certificates (not recommended for production)
TLS_REJECT_UNAUTHORIZED=0

# Authentication type: 'xsuaa' for JWT (OAuth2), 'basic' for username/password
SAP_AUTH_TYPE=xsuaa

# SAP system type: cloud (default), onprem, or legacy
# Controls which tools are available (e.g. Programs are onprem-only)
# Default is 'cloud' — set to 'onprem' for on-premise systems
SAP_SYSTEM_TYPE=cloud

# For JWT (XSUAA) authentication
SAP_JWT_TOKEN=your_jwt_token_here

# For basic authentication (uncomment if using basic auth)
# SAP_AUTH_TYPE=basic
# SAP_USERNAME=your_username
# SAP_PASSWORD=your_password

# System context for on-premise systems (required for create/update operations)
# SAP_MASTER_SYSTEM=DEV
# SAP_RESPONSIBLE=your_username

# Timeout configuration (in milliseconds). All three are COMMENTED OUT on
# purpose — the defaults below are what the libraries use when you set nothing,
# and for the first one "nothing" is the right answer.
#
# A client-side deadline does not stop the server: it ends what this side knows
# about a request SAP is still executing. @mcp-abap-adt/adt-clients dropped its
# own 45-second default for a measured reason — an aborted POST /deletion/delete
# was retried into a NEW session while the ABAP session underneath kept the
# enqueue locks, leaving the lock handle dead, the lock alive and unreachable,
# and the object locked and inactive. Uncomment only with a specific reason, and
# expect that cost.

# Deadline on every ADT request. Unset means none (the default since
# adt-clients 19). This file used to ship 45000 uncommented.
# SAP_TIMEOUT_DEFAULT=0

# Timeout for CSRF token requests (default: 15000ms = 15 seconds). This one is
# a short handshake, not work the server is doing on your behalf.
# SAP_TIMEOUT_CSRF=15000

# Floor for operations the library knows are slow (default: 120000ms in
# adt-clients; 60000ms in the connection package). A handler that knows better
# passes its own timeout — see PUBLISH_TIMEOUT_MS in handleUpdateServiceBinding.
# SAP_TIMEOUT_LONG=120000
