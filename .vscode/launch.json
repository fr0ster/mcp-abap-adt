{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "MCP Server - SSE",
      "program": "${workspaceFolder}/sse/bin/mcp-abap-adt-sse.js",
      "args": [],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/sse/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "env": {
        "NODE_ENV": "development",
        "MCP_SSE_PORT": "3001"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "MCP Server - StreamableHTTP",
      "program": "${workspaceFolder}/http/bin/mcp-abap-adt-http.js",
      "args": [],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/http/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "env": {
        "NODE_ENV": "development",
        "MCP_HTTP_PORT": "3000"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "MCP Inspector - STDIO",
      "program": "${workspaceFolder}/node_modules/@modelcontextprotocol/inspector/cli/build/cli.js",
      "args": ["node", "${workspaceFolder}/server/bin/mcp-abap-adt.js", "--env-path", "${workspaceFolder}/.env"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/server/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "MCP Server - STDIO",
      "program": "${workspaceFolder}/server/bin/mcp-abap-adt.js",
      "args": ["--env-path", "${workspaceFolder}/.env"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js", "${workspaceFolder}/server/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Tests",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": ["--runInBand"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "internalConsole",
      "env": {
        "NODE_ENV": "test"
      }
    }
  ]
}
