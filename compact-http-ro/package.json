{
  "name": "@mcp-abap-adt/compact-http-ro",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-compact-http-ro",
  "version": "24.2.1",
  "description": "The read-only compact MCP server for SAP ABAP ADT over Streamable HTTP, on premise (ECC, S/4HANA) and SAP BTP ABAP Cloud: the compact tools that change nothing: reads, where-used, checks, transport reads, unit-test results, the abapGit reads, background long reads, batch mode, MCP prompts and access restrictions. Credentials only from each request's x-sap-* headers; a long session by state_handle. No auth broker, no stores.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "abap-cloud",
    "sap-btp",
    "s4hana",
    "on-premise",
    "where-used",
    "atc",
    "abap-unit",
    "transports",
    "mcp-prompts",
    "access-control",
    "read-only",
    "compact",
    "batch",
    "streamable-http"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "bin": {
    "mcp-abap-adt-compact-http-ro": "./bin/mcp-abap-adt-compact-http-ro.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --root compact-http-ro/src",
    "lint:check": "biome check src",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/mcp-abap-adt-compact-http-ro.js"
  },
  "dependencies": {
    "@mcp-abap-adt/background-runs-memory": "^24.2.1",
    "@mcp-abap-adt/compact-readonly-entries": "^24.2.1",
    "@mcp-abap-adt/lib": "^24.2.1",
    "@mcp-abap-adt/responsible-rules": "^24.2.1",
    "@mcp-abap-adt/server-runtime": "^24.2.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^22.20.5"
  }
}
