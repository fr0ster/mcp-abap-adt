{
  "name": "@mcp-abap-adt/compact-http-ro",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-compact-http-ro",
  "version": "19.2.0",
  "description": "The read-only compact MCP server for SAP ABAP ADT over Streamable HTTP: the 17 compact tools that change nothing, with credentials only from the x-sap-* headers of each request. No auth broker, no stores.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "sap",
    "abap",
    "adt",
    "mcp",
    "mcp-server",
    "compact",
    "read-only",
    "streamable-http"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "bin": {
    "mcp-abap-adt-compact-http-ro": "./bin/mcp-abap-adt-compact-http-ro.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npx tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --roots compact-http-ro/src",
    "lint:check": "npx biome check src",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/mcp-abap-adt-compact-http-ro.js"
  },
  "dependencies": {
    "@mcp-abap-adt/background-runs-memory": "^19.2.0",
    "@mcp-abap-adt/compact-readonly-entries": "^19.2.0",
    "@mcp-abap-adt/lib": "^19.2.0",
    "@mcp-abap-adt/responsible-rules": "^19.2.0",
    "@mcp-abap-adt/server-runtime": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^22.20.5"
  }
}
