{
  "name": "@mcp-abap-adt/compact-sse",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-compact-sse",
  "version": "17.1.0",
  "description": "The compact MCP server for SAP ABAP ADT over HTTP+SSE: one tool per operation with the object in the arguments — 25 tools instead of 370 — with credentials only from the x-sap-* headers of the request that opens each SSE connection. No auth broker, no stores.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "sap",
    "abap",
    "adt",
    "mcp",
    "mcp-server",
    "compact",
    "sse"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "bin": {
    "mcp-abap-adt-compact-sse": "./bin/mcp-abap-adt-compact-sse.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npx tsc -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "lint:check": "npx biome check src",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/mcp-abap-adt-compact-sse.js"
  },
  "dependencies": {
    "@mcp-abap-adt/compact-modify": "^18.1.0",
    "@mcp-abap-adt/compact-readonly": "^18.1.0",
    "@mcp-abap-adt/sse": "^17.1.0",
    "@mcp-abap-adt/lib": "^18.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^22.20.5"
  }
}
