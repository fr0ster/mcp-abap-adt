{
  "name": "@mcp-abap-adt/core-ro",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-ro",
  "version": "24.2.0",
  "description": "The read-only MCP server for SAP ABAP ADT over stdio, on premise (ECC, S/4HANA) and SAP BTP ABAP Cloud: nothing that changes the system: where-used, search, source and metadata reads, ATC and unit-test results, transport reads, the abapGit reads, background long reads, MCP prompts and access restrictions, and the leftover-session list. One destination through the auth broker; connects over HTTP, RFC or SNC (RFC and SNC need the SAP NW RFC library at run time).",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "abap-cloud",
    "sap-btp",
    "s4hana",
    "on-premise",
    "where-used",
    "atc",
    "abap-unit",
    "transports",
    "mcp-prompts",
    "access-control",
    "read-only"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "bin": {
    "mcp-abap-adt-ro": "./bin/mcp-abap-adt-ro.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --root core-ro/src",
    "lint:check": "biome check src",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/mcp-abap-adt-ro.js"
  },
  "dependencies": {
    "@mcp-abap-adt/background-runs-memory": "^24.2.0",
    "@mcp-abap-adt/lib": "^24.2.0",
    "@mcp-abap-adt/responsible-rules": "^24.2.0",
    "@mcp-abap-adt/server-runtime": "^24.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^22.20.5"
  }
}
