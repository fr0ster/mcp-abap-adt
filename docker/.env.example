# Example environment configuration for docker compose (variable substitution)
# Copy this file to docker/.env

# The version of the variant's package the image installs from npm (default: latest)
# MCP_ABAP_ADT_VERSION=<version>

# The SAP system type, required by every variant (no default, never guessed):
# onprem, cloud or legacy. Passed to every service as it is.
# SAP_SYSTEM_TYPE=onprem

# The destination is NOT set here: the server reads no environment variable for it.
# stdio services name it in the command:
#   docker compose run --rm -T core --mcp=<name>     ./service-keys/<name>.json
# Streamable HTTP and SSE services have no destinations: every request (SSE: the
# GET that opens the connection) carries x-sap-url and its credential in headers.

# Secrets and the session belong in .env files and the environment, never in YAML.
