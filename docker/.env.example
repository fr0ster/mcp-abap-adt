# Example environment configuration for docker-compose
# Copy this file to .env

# The destination is NOT set here: the server reads no environment variable for it.
# Choose it in the container command (docker-compose.yml / docker-compose.package.yml):
#   --mcp=<name>                 an own default destination: ./service-keys/<name>.json
#   --allow-destination-header   clients send x-mcp-destination per request
# or in a YAML file passed with --config=<file>  (key: mcp)

# Optional: Custom port
# MCP_HTTP_PORT=3000

# Optional: Custom host
# MCP_HTTP_HOST=0.0.0.0

# Optional: login callback port for a browser login (default 61001)
# MCP_BROWSER_AUTH_PORT=61001

# Secrets and the session belong in .env files and the environment, never in YAML.
