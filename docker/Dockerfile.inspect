# The image Glama builds for inspecting the server: the published package from
# the registry behind mcp-proxy, with no destination (inspection-only mode).
# Glama keeps its own copy of this Dockerfile on its admin page; this one is the
# reference to keep it in step with.

FROM node:22-bookworm-slim

ARG CORE_VERSION=latest
RUN npm install -g --omit=optional --no-audit --no-fund "@mcp-abap-adt/core@${CORE_VERSION}" mcp-proxy@6.7.19 \
 && npm cache clean --force \
 && mcp-abap-adt --version

USER node
WORKDIR /home/node

CMD ["mcp-proxy", "mcp-abap-adt"]
