# mcp-abap-adt server installed from package tarballs in docker/packages/.
#
# Put the @mcp-abap-adt/core tarball there — from the registry:
#   npm pack @mcp-abap-adt/core@<version> --pack-destination docker/packages
# or tarballs packed from a build (lib and core together, and the compact
# packages if you want them). Everything not in docker/packages comes from the
# registry. See docker/README.package.md.
#
# RFC and SNC are not available in this image: @mcp-abap-adt/sap-rfc-lite is
# compiled at install time against the SAP NW RFC SDK, which the image does not
# carry.

FROM node:22-bookworm-slim

RUN --mount=type=bind,source=docker/packages,target=/packages \
    npm install -g --omit=dev --omit=optional --no-audit --no-fund /packages/*.tgz \
 && npm cache clean --force \
 && mcp-abap-adt --version

WORKDIR /app

ENV NODE_ENV=production \
    MCP_HTTP_PORT=3000 \
    MCP_HTTP_HOST=0.0.0.0 \
    AUTH_BROKER_PATH=/app

RUN mkdir -p /app/service-keys /app/sessions && chown -R node:node /app
USER node

EXPOSE 3000

# stdio by default (for MCP inspection): without a destination the server runs
# in inspection-only mode. docker-compose.package.yml starts it over HTTP.
CMD ["mcp-abap-adt", "--transport=stdio"]
