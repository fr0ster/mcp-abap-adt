{
  "name": "@mcp-abap-adt/http",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-http",
  "version": "19.1.0",
  "description": "The Streamable HTTP transport of the MCP ABAP ADT server: an Express app serving the ADT tools of @mcp-abap-adt/lib over MCP Streamable HTTP, with DNS rebinding protection and TLS.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "streamable-http"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "typesVersions": {
    "*": {
      "launcher": [
        "dist/launcher.d.ts"
      ]
    }
  },
  "bin": {
    "mcp-abap-adt-http": "./bin/mcp-abap-adt-http.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npx tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --roots http/src",
    "test:check": "npx tsc --noEmit -p tsconfig.test.json",
    "lint:check": "npx biome check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mcp-abap-adt/background-runs-memory": "^19.1.0",
    "@mcp-abap-adt/lib": "^19.1.0",
    "@mcp-abap-adt/logger": "^0.4.1",
    "@mcp-abap-adt/responsible-rules": "^19.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "*",
    "@types/jest": "*",
    "@types/node": "*",
    "typescript": "*"
  }
}
