{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "module": "node16",
    "moduleResolution": "node16",
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
    "noImplicitAny": false,
    "paths": {
      "@mcp-abap-adt/background-runs-memory": [
        "../background-runs-memory/dist/index.d.ts"
      ],
      "@mcp-abap-adt/responsible-rules": [
        "../responsible-rules/dist/index.d.ts"
      ],
      "@mcp-abap-adt/lib": [
        "../dist/index.d.ts"
      ],
      "@mcp-abap-adt/lib/handlers": [
        "../dist/lib/handlers/index.d.ts"
      ],
      "@mcp-abap-adt/lib/http-transport": [
        "../dist/lib/httpTransport/index.d.ts"
      ],
      "@mcp-abap-adt/lib/utils": [
        "../dist/lib/utils.d.ts"
      ],
      "@mcp-abap-adt/lib/embeddable": [
        "../dist/embeddable/index.d.ts"
      ],
      "@mcp-abap-adt/lib/config": [
        "../dist/lib/config/index.d.ts"
      ],
      "@mcp-abap-adt/lib/auth": [
        "../dist/lib/auth/index.d.ts"
      ],
      "@mcp-abap-adt/lib/logger": [
        "../dist/lib/handlerLogger.d.ts"
      ],
      "@mcp-abap-adt/lib/request-context": [
        "../dist/lib/requestContext.d.ts"
      ],
      "@mcp-abap-adt/lib/state": [
        "../dist/lib/state/index.d.ts"
      ],
      "@mcp-abap-adt/lib/tool-set": [
        "../dist/lib/toolSet.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/__tests__/**"
  ]
}
