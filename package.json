      "require": "./dist/lib/state/index.js"
    },
    "./tool-set": {
      "types": "./dist/lib/toolSet.d.ts",
      "import": "./dist/lib/toolSet.js",
      "require": "./dist/lib/toolSet.js"
    },
    "./adt-headers": {
      "types": "./dist/lib/adtHeaders/index.d.ts",
      "import": "./dist/lib/adtHeaders/index.js",
      "require": "./dist/lib/adtHeaders/index.js"
    },
    "./tool-search": {
      "types": "./dist/lib/toolSearch/index.d.ts",
      "import": "./dist/lib/toolSearch/index.js",
      "require": "./dist/lib/toolSearch/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "handlers": [
        "dist/lib/handlers/index.d.ts"
      ],
      "utils": [
        "dist/lib/utils.d.ts"
      ],
      "embeddable": [
        "dist/embeddable/index.d.ts"
      ],
      "config": [
        "dist/lib/config/index.d.ts"
      ],
      "auth": [
        "dist/lib/auth/index.d.ts"
      ],
      "logger": [
        "dist/lib/handlerLogger.d.ts"
      ],
      "request-context": [
        "dist/lib/requestContext.d.ts"
      ],
      "handlers/read": [
        "dist/lib/handlers/read.d.ts"
      ],
      "handlers/write": [
        "dist/lib/handlers/write.d.ts"
      ],
      "compact-shared": [
        "dist/lib/compact/index.d.ts"
      ],
      "http-transport": [
        "dist/lib/httpTransport/index.d.ts"
      ],
      "debugger": [
        "dist/lib/debugger/index.d.ts"
      ],
      "state": [
        "dist/lib/state/index.d.ts"
      ],
      "tool-set": [
        "dist/lib/toolSet.d.ts"
      ],
      "adt-headers": [
        "dist/lib/adtHeaders/index.d.ts"
      ],
      "tool-search": [
        "dist/lib/toolSearch/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test:init": "node -e \"const fs=require('fs'),s='tests/test-config.yaml',t=s+'.template';if(fs.existsSync(s)){console.log(s+' already exists, skipping (use test:reinit to overwrite)')}else{fs.copyFileSync(t,s);console.log('Created '+s+' — edit lines marked CHANGE')}\"",
    "test:reinit": "node -e \"const fs=require('fs'),s='tests/test-config.yaml',t=s+'.template';fs.copyFileSync(t,s);console.log('Recreated '+s+' from template')\"",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --testPathPatterns=integration --testPathIgnorePatterns='__tests__/admin/' --runInBand --passWithNoTests --forceExit",
    "test:high": "jest --testPathPatterns='integration.*High' --testPathIgnorePatterns='__tests__/admin/' --runInBand --passWithNoTests --forceExit",
    "test:check": "npx tsc --noEmit -p tsconfig.test.json",
    "shared:setup": "jest --testPathPatterns='admin/shared-deps/setup' --testPathIgnorePatterns='[]' --runInBand --passWithNoTests",
    "shared:teardown": "jest --testPathPatterns='admin/shared-deps/teardown' --testPathIgnorePatterns='[]' --runInBand --passWithNoTests",
    "shared:check": "jest --testPathPatterns='admin/shared-deps/check' --testPathIgnorePatterns='[]' --passWithNoTests",
    "polygon:backup": "adt-backup backup --package ZMCP_SHR_PKG --env-path trial.env --output tests/fixtures/polygon.backup.yaml",
    "lint": "npx biome check --write src",
    "lint:check": "npx biome check src",
    "format": "npx biome format --write src",
    "prebuild": "node -e \"const fs=require('node:fs');for(const d of ['dist','background-runs-memory/dist','responsible-rules/dist','server-runtime/dist','http/dist','sse/dist','server/dist','compact-readonly-entries/dist','compact-modify/dist','compact/dist','compact-http/dist','compact-sse/dist','core-ro/dist','http-ro/dist','sse-ro/dist','compact-ro/dist','compact-http-ro/dist','compact-sse-ro/dist'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "npx biome check --write --diagnostic-level=error src && npx tsc -p tsconfig.json && npx tsc -p background-runs-memory/tsconfig.json && npx tsc -p responsible-rules/tsconfig.json && npx tsc -p compact-readonly-entries/tsconfig.json && npx tsc -p compact-modify/tsconfig.json && npx tsc -p server-runtime/tsconfig.json && npx tsc -p server/tsconfig.json && npx tsc -p http/tsconfig.json && npx tsc -p sse/tsconfig.json && npx tsc -p compact/tsconfig.json && npx tsc -p compact-http/tsconfig.json && npx tsc -p compact-sse/tsconfig.json && npx tsc -p core-ro/tsconfig.json && npx tsc -p http-ro/tsconfig.json && npx tsc -p sse-ro/tsconfig.json && npx tsc -p compact-ro/tsconfig.json && npx tsc -p compact-http-ro/tsconfig.json && npx tsc -p compact-sse-ro/tsconfig.json",
    "build:fast": "npx tsc -p tsconfig.json",
    "check-todos": "node tools/check-todos.js",
    "clean": "make clean",
    "chrono": "./tools/version-stats.sh",
    "docs:tools": "npm run build && node ./tools/generate-tools-docs.js",
    "release:publish": "bash scripts/publish-all.sh",
    "release:dry": "bash scripts/publish-all.sh --dry-run",
    "prepublishOnly": "npm run build",
    "portable:build": "node scripts/portable/build.mjs all",
    "portable:build:full": "node scripts/portable/build.mjs full",
    "portable:build:compact": "node scripts/portable/build.mjs compact",
    "portable:smoke": "node scripts/portable/smoke.mjs",
    "package": "npm pack",
    "package:build": "npm run build && npm pack",
    "prepare": "husky",
    "smoke:mcp:crud": "node tools/mcp-crud-smoke.js",
    "smoke:mcp:matrix": "node tools/mcp-crud-matrix.js",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "abap-cloud",
    "sap-btp",
    "xsuaa",
    "jwt-auth",
    "service-key",
    "crud"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "description": "ADT tool handlers and an embeddable MCP server for SAP ABAP. The standalone server is @mcp-abap-adt/core.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@mcp-abap-adt/auth-broker": "^5.0.6",
    "@mcp-abap-adt/auth-stores": "^5.0.1",
    "@mcp-abap-adt/interfaces-auth-broker": "^1.3.0",
    "@modelcontextprotocol/inspector": "^2.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-util": "^30.5.1",
    "lint-staged": "^16.4.0",
    "postject": "^1.0.0-alpha.6",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@mcp-abap-adt/adt-clients": "^37.0.0",
    "@mcp-abap-adt/adt-strategies": "^0.15.0",
    "@mcp-abap-adt/auth-errors": "^2.2.1",
    "@mcp-abap-adt/auth-providers": "^6.0.2",
    "@mcp-abap-adt/connection": "^19.0.0",
    "@mcp-abap-adt/interfaces-adt": "^20.1.0",
    "@mcp-abap-adt/interfaces-adt-connection": "^3.0.0",
    "@mcp-abap-adt/interfaces-auth": "^7.5.0",
    "@mcp-abap-adt/interfaces-auth-sap": "^3.4.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.1",
    "@mcp-abap-adt/logger": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "axios": "^1.20.0",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "js-yaml": "^5.4.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@mcp-abap-adt/sap-rfc-lite": "^0.3.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist/",
    "tools/batch-handlers.json",
    "tools/tool-search.json",
    "docs/",
    "!docs/superpowers/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CONTRIBUTORS.md",
    "CHANGELOG.md"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/background-runs-memory/src",
      "<rootDir>/responsible-rules/src",
      "<rootDir>/server-runtime/src",
      "<rootDir>/server/src",
      "<rootDir>/http/src",
      "<rootDir>/sse/src",
      "<rootDir>/compact-readonly-entries/src",
      "<rootDir>/compact-modify/src",
      "<rootDir>/compact/src",
      "<rootDir>/compact-http/src",
      "<rootDir>/compact-sse/src",
      "<rootDir>/core-ro/src",
      "<rootDir>/http-ro/src",
      "<rootDir>/sse-ro/src",
      "<rootDir>/compact-ro/src",
      "<rootDir>/compact-http-ro/src",
      "<rootDir>/compact-sse-ro/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@mcp-abap-adt/lib$": "<rootDir>/src/index.ts",
      "^@mcp-abap-adt/lib/handlers$": "<rootDir>/src/lib/handlers/index.ts",
      "^@mcp-abap-adt/lib/handlers/read$": "<rootDir>/src/lib/handlers/read.ts",
      "^@mcp-abap-adt/lib/handlers/write$": "<rootDir>/src/lib/handlers/write.ts",
      "^@mcp-abap-adt/lib/compact-shared$": "<rootDir>/src/lib/compact/index.ts",
      "^@mcp-abap-adt/lib/debugger$": "<rootDir>/src/lib/debugger/index.ts",
      "^@mcp-abap-adt/lib/state$": "<rootDir>/src/lib/state/index.ts",
      "^@mcp-abap-adt/lib/utils$": "<rootDir>/src/lib/utils.ts",
      "^@mcp-abap-adt/lib/config$": "<rootDir>/src/lib/config/index.ts",
      "^@mcp-abap-adt/lib/embeddable$": "<rootDir>/src/embeddable/index.ts",
      "^@mcp-abap-adt/lib/logger$": "<rootDir>/src/lib/handlerLogger.ts",
      "^@mcp-abap-adt/lib/request-context$": "<rootDir>/src/lib/requestContext.ts",
      "^@mcp-abap-adt/lib/auth$": "<rootDir>/src/lib/auth/index.ts",
      "^@mcp-abap-adt/lib/http-transport$": "<rootDir>/src/lib/httpTransport/index.ts",
      "^@mcp-abap-adt/lib/tool-set$": "<rootDir>/src/lib/toolSet.ts",
      "^@mcp-abap-adt/lib/adt-headers$": "<rootDir>/src/lib/adtHeaders/index.ts",
      "^@mcp-abap-adt/lib/tool-search$": "<rootDir>/src/lib/toolSearch/index.ts",
      "^@mcp-abap-adt/background-runs-memory$": "<rootDir>/background-runs-memory/src/index.ts",
      "^@mcp-abap-adt/responsible-rules$": "<rootDir>/responsible-rules/src/index.ts",
      "^@mcp-abap-adt/compact-readonly-entries$": "<rootDir>/compact-readonly-entries/src/index.ts",
      "^@mcp-abap-adt/compact-modify$": "<rootDir>/compact-modify/src/index.ts",
      "^@mcp-abap-adt/server-runtime/stdio$": "<rootDir>/server-runtime/src/stdio/launcher.ts",
      "^@mcp-abap-adt/server-runtime/stdio/server$": "<rootDir>/server-runtime/src/stdio/server.ts",
      "^@mcp-abap-adt/server-runtime/auth$": "<rootDir>/server-runtime/src/stdio/auth/index.ts",
      "^@mcp-abap-adt/server-runtime/http$": "<rootDir>/server-runtime/src/http/launcher.ts",
      "^@mcp-abap-adt/server-runtime/http/server$": "<rootDir>/server-runtime/src/http/server.ts",
      "^@mcp-abap-adt/server-runtime/sse$": "<rootDir>/server-runtime/src/sse/launcher.ts",
      "^@mcp-abap-adt/server-runtime/sse/server$": "<rootDir>/server-runtime/src/sse/server.ts",
      "^@mcp-abap-adt/core/launcher$": "<rootDir>/server/src/launcher.ts",
      "^@mcp-abap-adt/core/auth$": "<rootDir>/server/src/auth/index.ts",
      "^@mcp-abap-adt/http$": "<rootDir>/http/src/index.ts",
      "^@mcp-abap-adt/sse$": "<rootDir>/sse/src/index.ts",
      "^@mcp-abap-adt/compact-readonly-entries/routes$": "<rootDir>/compact-readonly-entries/src/handlers/compactReadRoutes.ts",
      "^@mcp-abap-adt/compact-modify/routes$": "<rootDir>/compact-modify/src/handlers/compactWriteRoutes.ts",
      "^@mcp-abap-adt/http/launcher$": "<rootDir>/http/src/launcher.ts",
      "^@mcp-abap-adt/sse/launcher$": "<rootDir>/sse/src/launcher.ts",
      "^@mcp-abap-adt/compact/launcher$": "<rootDir>/compact/src/launcher.ts",
      "^@mcp-abap-adt/compact-http/launcher$": "<rootDir>/compact-http/src/launcher.ts",
      "^@mcp-abap-adt/compact-sse/launcher$": "<rootDir>/compact-sse/src/launcher.ts",
      "^@mcp-abap-adt/core-ro/launcher$": "<rootDir>/core-ro/src/launcher.ts",
      "^@mcp-abap-adt/http-ro/launcher$": "<rootDir>/http-ro/src/launcher.ts",
      "^@mcp-abap-adt/sse-ro/launcher$": "<rootDir>/sse-ro/src/launcher.ts",
      "^@mcp-abap-adt/compact-ro/launcher$": "<rootDir>/compact-ro/src/launcher.ts",
      "^@mcp-abap-adt/compact-http-ro/launcher$": "<rootDir>/compact-http-ro/src/launcher.ts",
      "^@mcp-abap-adt/compact-sse-ro/launcher$": "<rootDir>/compact-sse-ro/src/launcher.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/__tests__/**",
      "!src/**/index.ts"
    ],
    "testPathIgnorePatterns": [
      "__tests__/admin/",
      "__tests__/integration/"
    ],
    "maxWorkers": 1,
    "testTimeout": 600000,
    "globalSetup": "<rootDir>/src/__tests__/integration/globalSetup.ts",
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/integration/helpers/closeConnectionsAfterAll.ts"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "biome check --write"
    ]
  },
  "private": false
}
