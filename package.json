    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./handlers": {
      "types": "./dist/lib/handlers/index.d.ts",
      "import": "./dist/lib/handlers/index.js",
      "require": "./dist/lib/handlers/index.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "require": "./dist/lib/utils.js"
    },
    "./embeddable": {
      "types": "./dist/embeddable/index.d.ts",
      "import": "./dist/embeddable/index.js",
      "require": "./dist/embeddable/index.js"
    },
    "./config": {
      "types": "./dist/lib/config/index.d.ts",
