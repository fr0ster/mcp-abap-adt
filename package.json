  "scripts": {
    "test:init": "node -e \"const fs=require('fs'),s='tests/test-config.yaml',t=s+'.template';if(fs.existsSync(s)){console.log(s+' already exists, skipping (use test:reinit to overwrite)')}else{fs.copyFileSync(t,s);console.log('Created '+s+' — edit lines marked CHANGE')}\"",
    "test:reinit": "node -e \"const fs=require('fs'),s='tests/test-config.yaml',t=s+'.template';fs.copyFileSync(t,s);console.log('Recreated '+s+' from template')\"",
    "pretest": "npm run build:test-reporter",
    "test": "node tools/npm-test.mjs --concurrency 2",
    "test:build": "node tools/build-node-tests.mjs",
    "pretest:integration": "npm run build:test-reporter",
    "test:integration": "jest --testPathPatterns=integration --testPathIgnorePatterns='__tests__/admin/' --runInBand --passWithNoTests --forceExit --reporters=default --reporters=./build/test-reporter/coverageReporter.js",
    "pretest:coverage-family": "npm run build:test-reporter",
    "test:coverage-family": "jest --reporters=default --reporters=./build/test-reporter/coverageReporter.js --testPathIgnorePatterns='__tests__/admin/' --runInBand --forceExit",
    "test:live-connection": "jest --testPathIgnorePatterns='__tests__/admin/' --runInBand --forceExit src/__tests__/integration/live/liveConnection.test.ts",
    "test:high": "jest --testPathPatterns='integration.*High' --testPathIgnorePatterns='__tests__/admin/' --runInBand --passWithNoTests --forceExit",
    "test:check": "tsc --noEmit -p tsconfig.test.json",
    "build:test-reporter": "tsc -p tsconfig.reporter.json",
    "check:test-reporter": "node --eval \"require('./build/test-reporter/coverageReporter.js')\"",
    "shared:setup": "jest --testPathPatterns='admin/shared-deps/setup' --testPathIgnorePatterns='[]' --runInBand --passWithNoTests",
    "shared:teardown": "jest --testPathPatterns='admin/shared-deps/teardown' --testPathIgnorePatterns='[]' --runInBand --passWithNoTests",
    "shared:check": "jest --testPathPatterns='admin/shared-deps/check' --testPathIgnorePatterns='[]' --runInBand --passWithNoTests",
    "polygon:backup": "adt-backup backup --package ZMCP_SHR_PKG --env-path trial.env --output tests/fixtures/polygon.backup.yaml",
    "lint": "biome check --write src scripts tools/build-node-tests.mjs tools/node-test-list.mjs tools/npm-test.mjs tools/run-tests.mjs background-runs-memory/src responsible-rules/src compact-readonly-entries/src compact-modify/src server-runtime/src server/src http/src sse/src compact/src compact-http/src compact-sse/src core-ro/src http-ro/src sse-ro/src compact-ro/src compact-http-ro/src compact-sse-ro/src",
    "lint:check": "biome check src scripts tools/build-node-tests.mjs tools/node-test-list.mjs tools/npm-test.mjs tools/run-tests.mjs background-runs-memory/src responsible-rules/src compact-readonly-entries/src compact-modify/src server-runtime/src server/src http/src sse/src compact/src compact-http/src compact-sse/src core-ro/src http-ro/src sse-ro/src compact-ro/src compact-http-ro/src compact-sse-ro/src",
    "format": "biome format --write src",
    "prebuild": "node -e \"const fs=require('node:fs');for(const d of ['dist','background-runs-memory/dist','responsible-rules/dist','server-runtime/dist','http/dist','sse/dist','server/dist','compact-readonly-entries/dist','compact-modify/dist','compact/dist','compact-http/dist','compact-sse/dist','core-ro/dist','http-ro/dist','sse-ro/dist','compact-ro/dist','compact-http-ro/dist','compact-sse-ro/dist'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "biome check --write --diagnostic-level=error src scripts tools/build-node-tests.mjs tools/node-test-list.mjs tools/npm-test.mjs tools/run-tests.mjs background-runs-memory/src responsible-rules/src compact-readonly-entries/src compact-modify/src server-runtime/src server/src http/src sse/src compact/src compact-http/src compact-sse/src core-ro/src http-ro/src sse-ro/src compact-ro/src compact-http-ro/src compact-sse-ro/src && tsc -p tsconfig.json && tsc -p background-runs-memory/tsconfig.json && tsc -p responsible-rules/tsconfig.json && tsc -p compact-readonly-entries/tsconfig.json && tsc -p compact-modify/tsconfig.json && tsc -p server-runtime/tsconfig.json && tsc -p server/tsconfig.json && tsc -p http/tsconfig.json && tsc -p sse/tsconfig.json && tsc -p compact/tsconfig.json && tsc -p compact-http/tsconfig.json && tsc -p compact-sse/tsconfig.json && tsc -p core-ro/tsconfig.json && tsc -p http-ro/tsconfig.json && tsc -p sse-ro/tsconfig.json && tsc -p compact-ro/tsconfig.json && tsc -p compact-http-ro/tsconfig.json && tsc -p compact-sse-ro/tsconfig.json",
    "build:fast": "tsc -p tsconfig.json",
    "check-todos": "node tools/check-todos.js",
    "clean": "make clean",
    "chrono": "./tools/version-stats.sh",
    "docs:tools": "npm run build && node ./tools/generate-tools-docs.js",
    "release:publish": "bash scripts/publish-all.sh",
    "release:dry": "bash scripts/publish-all.sh --dry-run",
    "prepublishOnly": "npm run build",
    "portable:build": "node scripts/portable/build.mjs all",
    "portable:build:full": "node scripts/portable/build.mjs full",
    "portable:build:compact": "node scripts/portable/build.mjs compact",
    "portable:smoke": "node scripts/portable/smoke.mjs",
    "package": "npm pack",
    "package:build": "npm run build && npm pack",
    "prepare": "husky",
    "smoke:mcp:crud": "node tools/mcp-crud-smoke.js",
    "smoke:mcp:matrix": "node tools/mcp-crud-matrix.js",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
