      ],
      "@mcp-abap-adt/sse/launcher": [
        "../sse/src/launcher.ts"
      ],
      "@mcp-abap-adt/compact/launcher": [
        "../compact/src/launcher.ts"
      ],
      "@mcp-abap-adt/compact-http/launcher": [
        "../compact-http/src/launcher.ts"
      ],
      "@mcp-abap-adt/compact-sse/launcher": [
        "../compact-sse/src/launcher.ts"
      ],
      "@mcp-abap-adt/core-ro/launcher": [
        "../core-ro/src/launcher.ts"
      ],
      "@mcp-abap-adt/http-ro/launcher": [
        "../http-ro/src/launcher.ts"
      ],
      "@mcp-abap-adt/sse-ro/launcher": [
