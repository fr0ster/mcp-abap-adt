      "@mcp-abap-adt/server-runtime/stdio/server": [
        "../server-runtime/src/stdio/server.ts"
      ],
      "@mcp-abap-adt/server-runtime/auth": [
        "../server-runtime/src/stdio/auth/index.ts"
      ],
      "@mcp-abap-adt/core/launcher": [
        "../server/src/launcher.ts"
      ],
      "@mcp-abap-adt/core/auth": [
        "../server/src/auth/index.ts"
      ],
      "@mcp-abap-adt/http": [
        "../http/src/index.ts"
      ],
