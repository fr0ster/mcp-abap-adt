        "../src/lib/handlerLogger.ts"
      ],
      "@mcp-abap-adt/lib/request-context": [
        "../src/lib/requestContext.ts"
      ],
      "@mcp-abap-adt/lib/auth": [
        "../src/lib/auth/index.ts"
      ],
      "@mcp-abap-adt/lib/http-transport": [
        "../src/lib/httpTransport/index.ts"
      ],
      "@mcp-abap-adt/lib/tool-set": [
        "../src/lib/toolSet.ts"
