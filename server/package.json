{
  "name": "@mcp-abap-adt/core",
  "mcpName": "io.github.fr0ster/mcp-abap-adt",
  "version": "19.0.0",
  "description": "Standalone MCP server for SAP ABAP ADT over stdio: one destination through the auth broker (service keys, sessions, the browser login); connects to the system over HTTP, RFC or SNC (passwordless). RFC and SNC need the SAP NW RFC SDK at install time. Streamable HTTP is @mcp-abap-adt/http, SSE @mcp-abap-adt/sse; the compact variant is @mcp-abap-adt/compact.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "abap-cloud",
    "sap-btp",
    "xsuaa",
    "jwt-auth",
    "service-key",
    "crud"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "launcher": [
        "dist/launcher.d.ts"
      ],
      "auth": [
        "dist/auth/index.d.ts"
      ]
    }
  },
  "bin": {
    "mcp-abap-adt": "./bin/mcp-abap-adt.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npx tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --roots server/src",
    "test:check": "npx tsc --noEmit -p tsconfig.test.json",
    "lint:check": "npx biome check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mcp-abap-adt/auth-broker": "^5.0.6",
    "@mcp-abap-adt/auth-errors": "^2.2.1",
    "@mcp-abap-adt/auth-providers": "^6.0.2",
    "@mcp-abap-adt/auth-stores": "^5.0.1",
    "@mcp-abap-adt/connection": "^17.1.0",
    "@mcp-abap-adt/interfaces-auth": "^7.5.0",
    "@mcp-abap-adt/interfaces-auth-broker": "^1.3.0",
    "@mcp-abap-adt/interfaces-utils": "^1.1.1",
    "@mcp-abap-adt/background-runs-memory": "^19.0.0",
    "@mcp-abap-adt/lib": "^19.0.0",
    "@mcp-abap-adt/logger": "^0.4.1",
    "@mcp-abap-adt/responsible-rules": "^19.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^18.0.5"
  },
  "devDependencies": {
    "@types/jest": "*",
    "@types/node": "*",
    "typescript": "*"
  }
}
