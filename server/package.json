{
  "name": "@mcp-abap-adt/core",
  "mcpName": "io.github.fr0ster/mcp-abap-adt",
  "version": "17.2.1",
  "description": "Standalone MCP server for SAP ABAP ADT: stdio, SSE and streamable HTTP transports; connects to the system over HTTP, RFC or SNC (passwordless). RFC and SNC need the SAP NW RFC SDK at install time. The compact variant is @mcp-abap-adt/compact.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "abap-cloud",
    "sap-btp",
    "xsuaa",
    "jwt-auth",
    "service-key",
    "crud"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "typesVersions": {
    "*": {
      "launcher": [
        "dist/launcher.d.ts"
      ]
    }
  },
  "bin": {
    "mcp-abap-adt": "./bin/mcp-abap-adt.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npx tsc -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:check": "npx tsc --noEmit -p tsconfig.test.json",
    "lint:check": "npx biome check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mcp-abap-adt/interfaces-utils": "^1.1.1",
    "@mcp-abap-adt/lib": "^17.2.1",
    "@mcp-abap-adt/logger": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@mcp-abap-adt/lib$": "<rootDir>/../src/index.ts",
      "^@mcp-abap-adt/lib/handlers$": "<rootDir>/../src/lib/handlers/index.ts",
      "^@mcp-abap-adt/lib/utils$": "<rootDir>/../src/lib/utils.ts",
      "^@mcp-abap-adt/lib/embeddable$": "<rootDir>/../src/embeddable/index.ts",
      "^@mcp-abap-adt/lib/config$": "<rootDir>/../src/lib/config/index.ts",
      "^@mcp-abap-adt/lib/auth$": "<rootDir>/../src/lib/auth/index.ts",
      "^@mcp-abap-adt/lib/logger$": "<rootDir>/../src/lib/handlerLogger.ts",
      "^@mcp-abap-adt/lib/request-context$": "<rootDir>/../src/lib/requestContext.ts",
      "^@mcp-abap-adt/lib/debugger$": "<rootDir>/../src/lib/debugger/index.ts",
      "^@mcp-abap-adt/lib/state$": "<rootDir>/../src/lib/state/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "devDependencies": {
    "@types/express": "*",
    "@types/jest": "*",
    "@types/node": "*",
    "jest": "*",
    "ts-jest": "*",
    "typescript": "*"
  }
}
