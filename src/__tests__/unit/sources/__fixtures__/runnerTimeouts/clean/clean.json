{
  "scripts": {
    "test": "node tools/npm-test.mjs --concurrency 1",
    "test:integration": "jest --testPathPatterns=integration --runInBand --passWithNoTests --forceExit",
    "test:coverage-family": "jest --runInBand --forceExit",
    "test:live-connection": "jest --runInBand --forceExit src/__tests__/integration/live/liveConnection.test.ts",
    "test:high": "jest --testPathPatterns='integration.*High' --runInBand --passWithNoTests --forceExit",
    "test:words": "echo 'no --test-timeout, --test-force-exit or --forceExit here' && node -e \"console.log('--forceExit')\"",
    "test:near": "node tools/run-tests.mjs --concurrency 1 --test-timeouts --forceExitCode --test-force-exited"
  }
}
