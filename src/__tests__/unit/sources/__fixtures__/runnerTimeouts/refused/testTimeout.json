{
  "scripts": {
    "test:a": "node tools/run-tests.mjs --concurrency 1 --test-timeout=60000 src/a.test.ts",
    "test:b": "node tools/run-tests.mjs --concurrency 1 --test-timeout 60000 src/b.test.ts",
