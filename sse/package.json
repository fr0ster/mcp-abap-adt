{
  "name": "@mcp-abap-adt/sse",
  "mcpName": "io.github.fr0ster/mcp-abap-adt-sse",
  "version": "24.2.0",
  "description": "MCP server for SAP ABAP ADT over HTTP+SSE, on premise (ECC, S/4HANA) and SAP BTP ABAP Cloud: CRUD of ABAP, DDIC, CDS and RAP objects, where-used, ATC, unit tests, transports, the ABAP and AMDP debugger, abapGit, MCP prompts and access restrictions (deny lists, allowed packages, requests and tables), the data tools off by default. Credentials only from the x-sap-* headers of the request that opens each SSE connection. DNS rebinding protection and TLS.",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt.git"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "abap-cloud",
    "sap-btp",
    "s4hana",
    "on-premise",
    "where-used",
    "atc",
    "abap-unit",
    "transports",
    "mcp-prompts",
    "access-control",
    "crud",
    "debugger",
    "sse"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js",
      "require": "./dist/launcher.js"
    }
  },
  "typesVersions": {
    "*": {
      "launcher": [
        "dist/launcher.d.ts"
      ]
    }
  },
  "bin": {
    "mcp-abap-adt-sse": "./bin/mcp-abap-adt-sse.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm --prefix .. test -- --root sse/src",
    "test:check": "tsc --noEmit -p tsconfig.test.json",
    "lint:check": "biome check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mcp-abap-adt/background-runs-memory": "^24.2.0",
    "@mcp-abap-adt/lib": "^24.2.0",
    "@mcp-abap-adt/responsible-rules": "^24.2.0",
    "@mcp-abap-adt/server-runtime": "^24.2.0"
  },
  "devDependencies": {
    "@types/express": "*",
    "@types/node": "*",
    "typescript": "*"
  }
}
