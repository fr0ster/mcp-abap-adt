    "sends": "GET the type's source, or its metadata document where it has no source (as the full set's Get<Type>)",
    "when": [
      {
        "argument": "part",
        "equals": [
          "source"
        ]
      },
      {
        "argument": "object_type",
        "equals": [
          "PACKAGE",
          "DOMAIN",
          "DATA_ELEMENT",
          "TRANSPORT",
          "TABLE",
          "STRUCTURE",
          "DDL",
          "SERVICE_DEFINITION",
          "SERVICE_BINDING",
          "CLASS",
          "LOCAL_TEST_CLASS",
          "LOCAL_TYPES",
          "LOCAL_DEFINITIONS",
          "LOCAL_MACROS",
          "PROGRAM",
          "INTERFACE",
