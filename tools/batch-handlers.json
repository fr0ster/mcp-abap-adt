    "tool": "HandlerGet",
    "set": "compact",
    "handler": "compact-readonly-entries/src/handlers/handleHandlerGet.ts#handleHandlerGet",
    "sends": "GET the type's source, or its metadata document where it has no source (as the full set's Get<Type>)",
    "when": [
      {
        "argument": "part",
        "equals": [
          "source"
        ]
      },
      {
        "argument": "object_type",
        "equals": [
          "PACKAGE",
          "DOMAIN",
          "DATA_ELEMENT",
          "TRANSPORT",
          "TABLE",
          "STRUCTURE",
          "DDL",
          "SERVICE_DEFINITION",
          "SERVICE_BINDING",
          "CLASS",
          "LOCAL_TEST_CLASS",
          "LOCAL_TYPES",
          "LOCAL_DEFINITIONS",
          "LOCAL_MACROS",
          "PROGRAM",
          "INTERFACE",
          "FUNCTION_GROUP",
          "BEHAVIOR_DEFINITION",
          "BEHAVIOR_IMPLEMENTATION",
          "METADATA_EXTENSION"
        ]
      }
    ]
  },
  {
    "tool": "HandlerGet",
    "set": "compact",
    "handler": "compact-readonly-entries/src/handlers/handleHandlerGet.ts#handleHandlerGet",
    "sends": "GET the metadata document (as ReadPackage, ReadDomain, ReadDataElement, ReadFunctionGroup); for a type with a source, the source GET and the metadata GET together, neither waiting for the other (as Read<Type>). Not FUNCTION_MODULE: its source read is built from the metadata's function group",
    "when": [
      {
        "argument": "part",
        "equals": [
          "metadata"
        ]
      },
      {
        "argument": "object_type",
        "equals": [
          "PACKAGE",
          "DOMAIN",
          "DATA_ELEMENT",
          "FUNCTION_GROUP",
          "TABLE",
          "STRUCTURE",
          "DDL",
          "SERVICE_DEFINITION",
          "SERVICE_BINDING",
          "CLASS",
          "PROGRAM",
          "INTERFACE",
          "BEHAVIOR_DEFINITION",
          "BEHAVIOR_IMPLEMENTATION",
          "METADATA_EXTENSION"
        ]
      }
    ]
  },
  {
    "tool": "HandlerGet",
    "set": "compact",
    "handler": "compact-readonly-entries/src/handlers/handleHandlerGet.ts#handleHandlerGet",
    "sends": "GET /sap/bc/adt/repository/objectstructure?objecttype=…&objectname=…",
