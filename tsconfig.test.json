{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // The emitting tsconfig.json pins `rootDir` to `./src`, which is correct
    // for `dist/` but refuses any file under `scripts/` the moment this
    // config's `include` reaches there (TS6059). This config never emits —
    // ts-jest transpiles per-file and `tsc --noEmit -p` here is a checker
    // run, not a build — so widening `rootDir` to the repo root costs
    // nothing and lets the audit tooling under `scripts/` type-check with
    // the tests.
    //
    // Every TypeScript file under `scripts/` is checked here (#234): a script
    // that no longer compiles is a script nobody can run.
    "rootDir": ".",
    // The compact facade lives in sibling packages now, and the tests that
    // exercise it import them by package name. ts-jest resolves those names
    // through these paths, the jest runtime through `moduleNameMapper` in
    // package.json — the two lists have to agree, which is what
    // `packageEntryPoints`-style drift would otherwise hide.
    "paths": {
      "@mcp-abap-adt/lib": ["./src/index.ts"],
      "@mcp-abap-adt/lib/handlers": ["./src/lib/handlers/index.ts"],
      "@mcp-abap-adt/lib/handlers/read": ["./src/lib/handlers/read.ts"],
      "@mcp-abap-adt/lib/handlers/write": ["./src/lib/handlers/write.ts"],
      "@mcp-abap-adt/lib/compact-shared": ["./src/lib/compact/index.ts"],
      "@mcp-abap-adt/lib/debugger": ["./src/lib/debugger/index.ts"],
      "@mcp-abap-adt/lib/state": ["./src/lib/state/index.ts"],
      "@mcp-abap-adt/lib/utils": ["./src/lib/utils.ts"],
      "@mcp-abap-adt/lib/config": ["./src/lib/config/index.ts"],
      "@mcp-abap-adt/lib/embeddable": ["./src/embeddable/index.ts"],
      "@mcp-abap-adt/lib/logger": ["./src/lib/handlerLogger.ts"],
      "@mcp-abap-adt/lib/request-context": ["./src/lib/requestContext.ts"],
      "@mcp-abap-adt/lib/auth": ["./src/lib/auth/index.ts"],
      "@mcp-abap-adt/lib/http-transport": ["./src/lib/httpTransport/index.ts"],
      "@mcp-abap-adt/lib/tool-set": ["./src/lib/toolSet.ts"],
      "@mcp-abap-adt/lib/adt-headers": ["./src/lib/adtHeaders/index.ts"],
      "@mcp-abap-adt/lib/tool-search": ["./src/lib/toolSearch/index.ts"],
      "@mcp-abap-adt/background-runs-memory": ["./background-runs-memory/src/index.ts"],
      "@mcp-abap-adt/responsible-rules": ["./responsible-rules/src/index.ts"],
      "@mcp-abap-adt/compact-readonly-entries": ["./compact-readonly-entries/src/index.ts"],
      "@mcp-abap-adt/compact-readonly-entries/routes": ["./compact-readonly-entries/src/handlers/compactReadRoutes.ts"],
      "@mcp-abap-adt/compact-modify": ["./compact-modify/src/index.ts"],
      "@mcp-abap-adt/compact-modify/routes": ["./compact-modify/src/handlers/compactWriteRoutes.ts"],
      "@mcp-abap-adt/server-runtime/stdio": ["./server-runtime/src/stdio/launcher.ts"],
      "@mcp-abap-adt/server-runtime/stdio/server": ["./server-runtime/src/stdio/server.ts"],
      "@mcp-abap-adt/server-runtime/auth": ["./server-runtime/src/stdio/auth/index.ts"],
      "@mcp-abap-adt/server-runtime/http": ["./server-runtime/src/http/launcher.ts"],
      "@mcp-abap-adt/server-runtime/http/server": ["./server-runtime/src/http/server.ts"],
      "@mcp-abap-adt/server-runtime/sse": ["./server-runtime/src/sse/launcher.ts"],
      "@mcp-abap-adt/server-runtime/sse/server": ["./server-runtime/src/sse/server.ts"],
      "@mcp-abap-adt/core/launcher": ["./server/src/launcher.ts"],
      "@mcp-abap-adt/core/auth": ["./server/src/auth/index.ts"],
      "@mcp-abap-adt/http": ["./http/src/index.ts"],
      "@mcp-abap-adt/sse": ["./sse/src/index.ts"],
      "@mcp-abap-adt/http/launcher": ["./http/src/launcher.ts"],
      "@mcp-abap-adt/sse/launcher": ["./sse/src/launcher.ts"],
      "@mcp-abap-adt/compact/launcher": ["./compact/src/launcher.ts"],
      "@mcp-abap-adt/compact-http/launcher": ["./compact-http/src/launcher.ts"],
      "@mcp-abap-adt/compact-sse/launcher": ["./compact-sse/src/launcher.ts"],
      "@mcp-abap-adt/core-ro/launcher": ["./core-ro/src/launcher.ts"],
      "@mcp-abap-adt/http-ro/launcher": ["./http-ro/src/launcher.ts"],
      "@mcp-abap-adt/sse-ro/launcher": ["./sse-ro/src/launcher.ts"],
      "@mcp-abap-adt/compact-ro/launcher": ["./compact-ro/src/launcher.ts"],
      "@mcp-abap-adt/compact-http-ro/launcher": ["./compact-http-ro/src/launcher.ts"],
      "@mcp-abap-adt/compact-sse-ro/launcher": ["./compact-sse-ro/src/launcher.ts"]
    }
  },
  "include": [
    "src/**/*",
    "server-runtime/src/**/*",
    "compact-readonly-entries/src/**/*",
    "compact-modify/src/**/*",
    "compact/src/**/*",
    "compact-http/src/**/*",
    "compact-sse/src/**/*",
    "core-ro/src/**/*",
    "http-ro/src/**/*",
    "sse-ro/src/**/*",
    "compact-ro/src/**/*",
    "compact-http-ro/src/**/*",
    "compact-sse-ro/src/**/*",
    "src/__tests__/**/*",
    "src/lib/servers/v2/__tests__/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
