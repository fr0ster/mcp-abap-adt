{
  "extends": ["./tsconfig.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "types": ["node", "jest"],
    // The emitting tsconfig.json pins `rootDir` to `./src`, which is correct
    // for `dist/` but refuses any file under `scripts/` the moment this
    // config's `include` reaches there (TS6059). This config never emits —
    // ts-jest transpiles per-file and `tsc --noEmit -p` here is a checker
    // run, not a build — so widening `rootDir` to the repo root costs
    // nothing and lets the audit tooling under `scripts/` type-check with
    // the tests.
    //
    // Every TypeScript file under `scripts/` is checked here (#234): a script
    // that no longer compiles is a script nobody can run.
    "rootDir": ".",
    // The compact facade lives in sibling packages now, and the tests that
    // exercise it import them by package name. `paths` come from the one
    // package-name table, `tsconfig.paths.json`, through `extends` (D27):
    // this file defines none of its own, so the checker takes the table as it
    // is, and Jest's `moduleNameMapper` (`jest.config.js`) is built from the
    // same file.
  },
  "include": [
    "src/**/*",
    "server-runtime/src/**/*",
    "compact-readonly-entries/src/**/*",
    "compact-modify/src/**/*",
    "compact/src/**/*",
    "compact-http/src/**/*",
    "compact-sse/src/**/*",
    "core-ro/src/**/*",
    "http-ro/src/**/*",
    "sse-ro/src/**/*",
    "compact-ro/src/**/*",
    "compact-http-ro/src/**/*",
    "compact-sse-ro/src/**/*",
    "src/__tests__/**/*",
    "src/lib/servers/v2/__tests__/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // The coverage guard's refusal fixtures: source the guard reads as text
    // with the compiler API, each wrong on purpose — never compiled.
    "src/__tests__/unit/coverage/__fixtures__/coverage",
    // The RFC construction scan's refused fixtures and its limits: each
    // builds a config the compiler refuses under exactOptionalPropertyTypes,
    // on purpose; the scan reads them in its own program.
    "src/__tests__/unit/sources/__fixtures__/configConstruction/refused",
    "src/__tests__/unit/sources/__fixtures__/configConstruction/limits",
    // The analyse verdicts on an `analyse` key present as `undefined`: code
    // the compiler refuses under exactOptionalPropertyTypes, kept for the
    // analyser, which reads them in its own program.
    "src/__tests__/fixtures/analyse/no-explicit-undefined.ts",
    "src/__tests__/fixtures/analyse/no-shorthand-undefined.ts",
    "src/__tests__/fixtures/analyse/unknown-conditional.ts",
    "src/__tests__/fixtures/analyse/unknown-maybe-undefined.ts",
    "scripts/lib/__fixtures__/analyseOmissions/passesUndefined.fixture.ts"
  ]
}
